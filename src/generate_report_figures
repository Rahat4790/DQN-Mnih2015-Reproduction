
from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


# ============================================================
# PATHS AND SETTINGS
# ============================================================

ROOT = Path(__file__).resolve().parent.parent
RESULTS = ROOT / "results"

OUTPUT_DIR = RESULTS / "report_figures"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

SEEDS = [42, 123, 2025, 7, 21]
WINDOW = 50


# ============================================================
# HELPER: LOAD TRAINING REWARD CURVES
# ============================================================

def load_training_curves(folder):

    curves = []

    for seed in SEEDS:

        file = folder / f"seed_{seed}" / "episode_metrics.csv"

        if not file.exists():
            print(f"WARNING: Missing file: {file}")
            continue

        data = pd.read_csv(file)

        if "reward" not in data.columns:
            print(f"WARNING: No reward column in {file}")
            continue

        rewards = data["reward"].astype(float)

        smoothed = rewards.rolling(
            window=WINDOW,
            min_periods=1
        ).mean()

        curves.append(smoothed.reset_index(drop=True))

    if not curves:
        raise FileNotFoundError(
            f"No training curves found in {folder}"
        )

    combined = pd.concat(curves, axis=1)

    mean = combined.mean(axis=1)
    std = combined.std(axis=1)

    episodes = np.arange(1, len(mean) + 1)

    return episodes, mean, std


def plot_curve(ax, folder, label):

    episodes, mean, std = load_training_curves(folder)

    ax.plot(
        episodes,
        mean,
        label=label,
        linewidth=2
    )

    ax.fill_between(
        episodes,
        (mean - std).to_numpy(),
        (mean + std).to_numpy(),
        alpha=0.15
    )


