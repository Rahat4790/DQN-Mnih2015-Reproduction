print("Generating evaluation comparison...")


def load_evaluation(path, experiment_name):

    if not path.exists():
        raise FileNotFoundError(
            f"Evaluation summary not found: {path}"
        )

    data = pd.read_csv(path)

    # Normalize column names across summary formats
    rename = {
        "training_seed": "seed",
        "mean_reward": "mean",
        "std_reward": "episode_std",
        "max_reward": "max"
    }

    data = data.rename(columns=rename)

    required = {"seed", "mean"}

    if not required.issubset(data.columns):
        raise ValueError(
            f"Unexpected columns in {path}: {list(data.columns)}"
        )

    data["mean"] = pd.to_numeric(
        data["mean"],
        errors="coerce"
    )

    seed_means = data["mean"].dropna()

    return {
        "experiment": experiment_name,
        "seed_count": len(seed_means),
        "mean_reward": seed_means.mean(),
        "seed_std": seed_means.std(ddof=1),
        "median_reward": seed_means.median(),
        "seeds_500": int((seed_means >= 500).sum())
    }


evaluation_files = [
    (
        "Baseline (LR 0.0005)",
        RESULTS / "sensitivity" / "evaluation"
        / "evaluation_summary.csv"
    ),
    (
        "LR 0.0001",
        RESULTS / "sensitivity" / "learning_rate"
        / "lr_0.0001" / "evaluation" / "evaluation_summary.csv"
    ),
    (
